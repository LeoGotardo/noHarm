# ── Front-end (Vite) ────────────────────────────────────────────────────────
# The app talks to its own origin: nginx serves the bundle and proxies /api and
# /ws to the backend on loopback, so the same relative URLs work in dev, in the
# container, and in production.
#
# Keep VITE_SOCKET_URL defined but EMPTY: the connector only falls back to
# VITE_API_URL when the variable is missing, and "/api" is not a socket origin —
# socket.io reads the leading slash as a namespace.
VITE_API_URL=/api
VITE_SOCKET_URL=

# Where `npm run dev` proxies /api and /ws to. Dev only — the Vite proxy in
# vite.config.js mirrors the nginx routes so the app never needs a per-env base.
VITE_DEV_BACKEND_ORIGIN=http://localhost:8080

# Not secret: the Firebase web config and the status table reach the browser in
# the bundle regardless. They are build-time values — Vite inlines them, so a
# change needs a rebuild, not a restart. In the container they arrive as
# --build-arg (see noHarmBack/docker/Dockerfile).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_STATUS_CONSTANTS=

# Where an appeal goes: shown on a refused sign-in and on every moderation
# notice. Not a secret, and not optional in practice — a suspension the user
# cannot argue with is the thing that makes moderation feel arbitrary. Defaults
# to support@noharm.site when unset.
VITE_SUPPORT_EMAIL=support@noharm.site

# Days a deleted account is kept before it is permanently erased. Copy of the
# backend's ACCOUNT_DELETION_GRACE_DAYS, and used for one thing: telling the
# user, on the delete confirmation, how long they have to change their mind.
# The backend is the authority — the two must agree, or the app promises a
# window that does not exist. Defaults to 30 when unset.
VITE_DELETION_GRACE_DAYS=30

# Minimum age to hold an account. Copy of the backend's MINIMUM_AGE_YEARS, and
# used for one thing: answering on the register screen *before* the Google
# popup opens, so someone too young is not sent through a sign-in only to be
# refused afterwards. The backend enforces it and owns the real value — if the
# two disagree the server wins with a 403 the screen shows. Defaults to 18.
VITE_MINIMUM_AGE=18

# ── Back-end ────────────────────────────────────────────────────────────────
# Nothing here. The front-end no longer holds any server-side configuration:
# the proxy is nginx, and it reaches the backend over 127.0.0.1 with no origin,
# token or secret to configure. The backend's own variables live in
# noHarmBack/docker/prod.env — see core/config.py for the required set.

# The release tag, set by deploy-host.sh and the release workflow; shown in
# Settings. Leave unset locally — the screen then reads "dev".
VITE_APP_VERSION=
