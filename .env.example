# ── Front-end (Vite) ────────────────────────────────────────────────────────
# The app talks to its own origin; api/[...path].ts forwards to the backend.
# Keep VITE_SOCKET_URL defined but EMPTY: the connector only falls back to
# VITE_API_URL when the variable is missing, and "/api" is not a socket origin.
VITE_API_URL=/api
VITE_SOCKET_URL=

# Where `npm run dev` proxies /api and /ws to. Not used in production builds.
VITE_DEV_BACKEND_ORIGIN=http://localhost:8080

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_STATUS_CONSTANTS=

# ── Proxy functions (Vercel project env, server side) ───────────────────────
# Origin of the private backend. Never exposed to the client.
BACKEND_ORIGIN=https://noharm-back.vercel.app

# Optional overrides:
# BACKEND_OIDC_HEADER=x-vercel-trusted-oidc-idp-token
# BACKEND_SOCKET_PATH=/ws/socket.io/
# WS_MAX_PAYLOAD=2097152
